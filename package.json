{
  "name": "@yasser172/tec-sdk",
  "version": "1.2.2",
  "description": "TEC Unified SDK — High-performance bridge for Pi Network Microservices",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import":  "./dist/index.mjs",
      "types":   "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean":          "rm -rf dist",
    "build":          "tsup",
    "lint":           "eslint 'src/**/*.ts' --fix",
    "test":           "jest",
    "test:coverage":  "jest --coverage",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "zod":   "^3.22.4",
    "pino":  "^8.19.0"
  },
  "devDependencies": {
    "@types/jest":                      "^29.5.12",
    "@types/node":                      "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser":        "^7.0.1",
    "eslint":                           "^8.56.0",
    "eslint-plugin-import":             "^2.29.1",
    "jest":                             "^29.7.0",
    "ts-jest":                          "^29.1.2",
    "tsup":                             "^8.0.0",
    "typescript":                       "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access":   "public",
    "registry": "https://registry.npmjs.org"
  }
}
